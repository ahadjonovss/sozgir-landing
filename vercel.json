{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/ilova",
      "destination": "/ol/index.html"
    },
    {
      "source": "/:channel(t|x|th|i|tt|y|f|ln|ak)/ol",
      "destination": "/ol/index.html"
    },
    {
      "source": "/:page(oynash|oyin|sozjang|guncha|gunchajang|maydon|javoblar|qollanma|yangiliklar|nishonlar|qollab|privacy|hisob-ochirish|contact)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/cheksiz/4-harf",
      "destination": "/cheksiz/4-harf/index.html"
    },
    {
      "source": "/cheksiz/5-harf",
      "destination": "/cheksiz/5-harf/index.html"
    },
    {
      "source": "/cheksiz/6-harf",
      "destination": "/cheksiz/6-harf/index.html"
    },
    {
      "source": "/cheksiz/7-harf",
      "destination": "/cheksiz/7-harf/index.html"
    },
    {
      "source": "/qollanma/birinchi-soz",
      "destination": "/qollanma/birinchi-soz/index.html"
    },
    {
      "source": "/qollanma/taktika",
      "destination": "/qollanma/taktika/index.html"
    },
    {
      "source": "/qollanma/qiyin-sozlar",
      "destination": "/qollanma/qiyin-sozlar/index.html"
    },
    {
      "source": "/oyinchi/:uid",
      "destination": "/oyinchi/index.html"
    },
    {
      "source": "/u/:uid",
      "destination": "/oyinchi/index.html"
    },
    {
      "source": "/jang/:code",
      "destination": "/sozjang/index.html"
    },
    {
      "source": "/maydon/:code",
      "destination": "/maydon/index.html"
    },
    {
      "source": "/kunlik",
      "destination": "/oyin/index.html"
    },
    {
      "source": "/ilova",
      "destination": "/ol/index.html"
    },
    {
      "source": "/((?!api/|\\.well-known/|app-ads\\.txt|ads\\.txt|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/(apple-app-site-association|assetlinks.json)",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
